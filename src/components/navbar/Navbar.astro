---
import kaithuerta_logo from "../../assets/kaithuerta_logo.webp";
import { navbarData } from "../../data/navbarData";
import { ArrowRight } from "@lucide/astro";
---

<header
  class="fixed top-0 z-40 w-full bg-surface/80 shadow-sm backdrop-blur-xs"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
  >
    <!-- Logo -->
    <a href="/" class="h-10 shrink-0 sm:h-12 lg:h-16">
      <img
        src={kaithuerta_logo.src}
        alt="kait huerta logo"
        class="h-full object-contain"
      />
    </a>

    <!-- Menu -->
    <div class="hidden flex-1 lg:block">
      <ul class="flex items-center justify-end gap-6 pr-4 text-sm lg:gap-8 lg:pr-10 lg:text-base">
        {
          navbarData.map((item) => (
            <li>
              <a
                href={item.href}
                class="transition hover:text-alert-neutral hover:underline hover:decoration-alert-neutral"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- CTA -->
    <div class="shrink-0">
      <a
        href="mailto:hello@kaithuerta.com"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-alert-neutral px-4 py-2 text-sm text-white tracking-wider transition hover:opacity-90 sm:px-5 lg:px-6 lg:text-base"
      >
        <span class="hidden sm:inline">Work With Me</span>
        <span class="sm:hidden">Work</span>
        <ArrowRight class="h-4 w-4 lg:h-5 lg:w-5" />
      </a>
    </div>
  </nav>
</header>
