---
import instagram from '../../assets/instagram.svg';
import tiktok from '../../assets/tiktok.svg';
---

<section class="flex flex-row-reverse justify-center items-center gap-4 mt-2">
  <p class="text-2xl font-medium">Based in Ontario, Canada</p>
  <div class="flex gap-2">
    <a
      href="https://www.instagram.com/kait.huerta?igsh=dnU1OTUxYjRraTI1&utm_source=qr"
      target="_blank"
      ><img
        src={instagram.src}
        width="40"
        height="40"
        alt="instagram logo"
        class="hover:-translate-y-0.5"
      /></a
    >
    <a
      href="https://www.tiktok.com/@kait.huerta?_r=1&_t=ZS-95PT5GSUiqw"
      target="_blank"
      ><img
        src={tiktok.src}
        width="40"
        height="40"
        alt="tiktok logo"
        class="hover:-translate-y-0.5"
      /></a
    >
  </div>
</section>
