---
import partnershipPic from "../../assets/partnershipPic.webp";
import { PartnershipData } from "../../data/partnershipData";
import {
  Heart,
  Target,
  MessagesSquare,
  CalendarDays,
  ArrowRight,
  Mail,
} from "@lucide/astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

type IconName = "Heart" | "Target" | "MessagesSquare";

const icons: Record<IconName, AstroComponentFactory> = {
  Heart,
  Target,
  MessagesSquare,
};
---

<section id="contact" class="w-full bg-secondary">
  <div class="relative h-75 md:h-100 lg:h-200 overflow-hidden">
    <img
      src={partnershipPic.src}
      alt="Kait and Daughter picture"
      loading="eager"
      class="block w-full h-full object-cover object-top"
    />

    <div class="absolute inset-0 z-10">
      <div class="max-w-6xl mx-auto h-full px-6">
        <div class="flex h-full w-[45%] flex-col justify-center">
          <!-- Header -->
          <div class="flex items-center gap-10.5 mb-2">
            <div class="w-46 h-0.5 bg-alert-neutral"></div>

            <Heart class="shrink-0 fill-alert-neutral stroke-alert-neutral" />
          </div>

          <h2 class="text-7xl font-bold uppercase">
            Let's kick off a great partnership
          </h2>

          <svg
            width="400"
            height="20"
            viewBox="0 0 400 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M6 12C70 2 160 0 240 4C300 7 350 10 394 6"
              stroke="#C96F7B"
              stroke-width="3"
              stroke-linecap="round"></path>
            <path
              d="M10 14C80 6 170 5 255 8C310 10 355 12 388 10"
              stroke="#C96F7B"
              stroke-width="1.5"
              stroke-linecap="round"
              opacity="0.65"></path>
          </svg>

          <!-- Description -->
          <p class="text-2xl w-90 mt-6">
            UGC is not a one-size-fits-all, so let's chat about how to make it
            work for you.
          </p>

          <!-- Partnership Cards -->
          <article class="flex justify-evenly items-center mt-5">
            {
              PartnershipData.map((item) => {
                const IconSvg = icons[item.icon];

                return (
                  <div
                    class={`flex flex-col justify-center items-center text-center
          ${item.id === "strategy" ? "border-x-2 border-neutral/40 px-4" : ""}`}
                  >
                    <div class="flex items-center justify-center bg-secondary w-14 h-14 rounded-full mb-3">
                      <IconSvg class="stroke-alert-neutral w-7 h-7" />
                    </div>
                    <h3 class="font-black uppercase text-sm">{item.title}</h3>
                    <p class="text-sm w-42">{item.description}</p>
                  </div>
                );
              })
            }
          </article>

          <!-- CTA -->
          <div class="flex justify-center w-full gap-4 items-stretch mt-8">
            <a
              href="https://calendly.com/your-link"
              target="_blank"
              rel="noopener"
              class="h-full inline-flex items-center gap-4 px-6 py-3 rounded-md bg-alert-neutral text-white hover:opacity-90"
            >
              <CalendarDays />
              <span class="flex flex-col leading-tight text-left">
                <span>Book a 15 min</span>
                <span>Strategy Call</span>
              </span>
              <ArrowRight />
            </a>
            <a
              href="mailto:hello@kaithuerta.com"
              target="_blank"
              rel="noopener"
              class="h-full inline-flex items-center gap-4 px-6 py-3 rounded-md bg-secondary text-alert-neutral font-semibold border-2 border-alert-neutral hover:opacity-90"
            >
              <Mail />
              Email Me
              <ArrowRight />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
