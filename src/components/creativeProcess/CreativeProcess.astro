---
import { videosComeWith } from "../../data/videosComeWith";
import { videosDontComeWith } from "../../data/videosDontComeWith";
import CreativeProcessCard from "./CreativeProcessCard.astro";

const items = videosComeWith;
const videosDontItems = videosDontComeWith;
---

<section class="w-full py-16 px-4">
  <div class="w-full max-w-6xl mx-auto flex flex-col items-center">
    <h2
      class="uppercase font-bold text-4xl md:text-6xl tracking-tighter text-center"
    >
      My Creative Process & Production
    </h2>

    <div class="w-full mt-10 grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Left Panel -->
      <CreativeProcessCard
        items={items}
        color="tertiary"
        iconStroke="green"
        title="My videos come with"
      />

      <!-- Right Panel -->
      <CreativeProcessCard
        items={videosDontItems}
        color="red-500"
        iconStroke="red"
        title="My videos don't come with"
      />
    </div>
  </div>
</section>
