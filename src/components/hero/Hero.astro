---
import hero from "../../assets/hero.webp";
import HeroHighlights from "./HeroHighlights.astro";

---

<section
  id="hero"
  class="relative min-h-180 w-full overflow-hidden sm:min-h-190 lg:h-screen lg:min-h-190"
>
  <!-- Background Image -->
  <img
    src={hero.src}
    alt="Kait influencer"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover object-[35%_center] sm:object-[40%_center] md:object-center lg:object-[center_38%]"
  />

  <!-- Mobile readability overlay -->
  <div
    class="absolute inset-0 z-2 bg-white/45 md:bg-transparent"
  ></div>

  <!-- Content -->
  <div class="absolute inset-0 z-3 grid grid-cols-1 md:grid-cols-2">
    <!-- Empty left side -->
    <div class="hidden md:block"></div>

    <!-- Right content -->
    <div
      class="flex items-center justify-center px-5 py-16 text-center sm:px-8 md:justify-start md:px-10 md:text-left lg:px-16 xl:px-20"
    >
      <div class="w-full max-w-170 animate-[fadeUp_0.8s_ease-out_both]">
        <p
          class="text-base font-medium tracking-[0.08em] text-[#494c51] sm:text-lg md:text-xl lg:text-[1.4rem]"
        >
          UGC Creator & Strategist | English and Spanish speaking
        </p>

        <h1
          class="mt-5 font-bold uppercase leading-[0.9] tracking-[-0.06em] text-[clamp(3rem,14vw,5rem)] md:text-[clamp(3.5rem,7vw,5rem)]"
        >
          <span class="block">Real moments.</span>
          <span class="mt-3 block">Real connection.</span>
          <span
            class="mt-3 block font-secondary italic normal-case tracking-wider text-alert-neutral"
          >
            Real Results.
          </span>

          <svg
            class="mt-3 h-auto w-full max-w-100 md:max-w-105"
            viewBox="0 0 400 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M6 12C70 2 160 0 240 4C300 7 350 10 394 6"
              stroke="#C96F7B"
              stroke-width="3"
              stroke-linecap="round"></path>
            <path
              d="M10 14C80 6 170 5 255 8C310 10 355 12 388 10"
              stroke="#C96F7B"
              stroke-width="1.5"
              stroke-linecap="round"
              opacity="0.65"></path>
          </svg>
        </h1>

        <p
          class="mt-6 max-w-140 text-base leading-[1.6] text-primary sm:text-lg md:text-xl lg:text-[1.3rem]"
        >
          I create authentic, relatable UGC content that helps mama and
          family-focused brands connect with real parents and turn everyday
          moments into impact.
        </p>

        <div class="mt-8 hidden 2xl:block">
          <HeroHighlights />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
