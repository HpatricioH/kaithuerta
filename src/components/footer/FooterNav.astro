---
import { footerNavData } from "../../data/footerNavData";
import instagram from "../../assets/instagram.svg";
import tiktok from "../../assets/tiktok.svg";
import { Mail } from "@lucide/astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

type IconName = "Mail" | "instagram" | "tiktok";
const icons: Record<IconName, AstroComponentFactory> = {
  Mail,
  instagram,
  tiktok,
};
---

<nav
  class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-8 py-8 text-center sm:grid-cols-2 lg:grid-cols-3"
>
  {
    footerNavData.map((item) => {
      const links = item.links;

      return (
        <div
          class={`flex justify-center lg:block ${
            item.title === "For Brands"
              ? "lg:border-x-2 lg:border-neutral/40 lg:px-12"
              : ""
          }`}
        >
          <div>
            <h2 class="text-lg font-semibold uppercase text-tertiary">
              {item.title}
            </h2>

            <ul class="mt-4 flex flex-col items-center gap-2">
              {links.map((link) => {
                const IconSvg = link.icon ? icons[link.icon] : null;

                return (
                  <li class="flex items-center gap-2 transition hover:text-alert-neutral hover:underline hover:decoration-alert-neutral">
                    {IconSvg && (
                      <IconSvg class="h-6 w-6 shrink-0 stroke-alert-neutral" />
                    )}

                    <a href={link.href}>{link.label}</a>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      );
    })
  }
</nav>
