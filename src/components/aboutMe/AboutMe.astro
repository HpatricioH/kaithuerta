---
import aboutMe from "../../assets/aboutme.webp";
import { Heart, Video, Target } from "@lucide/astro";
import { AboutMeData } from "../../data/aboutMeData";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

type IconName = "Heart" | "Video" | "Target";

const icons: Record<IconName, AstroComponentFactory> = {
	Heart,
	Video,
	Target,
};
---

<section class="w-full py-16 px-4 bg-secondary" id="about">
	<div class="flex w-full max-w-6xl mx-auto justify-center gap-6">
		<!-- Right Panel -->
		<div class="relative">
			<img
				src={aboutMe.src}
				alt="Kait about me picture"
				loading="eager"
				class="w-418 rounded-3xl shadow-2xl"
			/>
		</div>

		<!-- Left Panel -->
		<div>
			<!-- Header -->
			<h2
				class="text-4xl md:text-6xl font-bold tracking-tight leading-tight uppercase"
			>
				About Me
			</h2>
			<div class="w-24 h-0.5 bg-alert-neutral mb-5"></div>
			<p class="font-secondary italic text-alert-neutral text-4xl font-medium">
				"Real life content builds real trust"
			</p>

			<!-- Body -->
			<p class="mt-4 text-lg">
				I've always loved capturing real-life moments, and becoming a <span
					class="text-tertiary font-bold">Mama</span
				> gave that passion a whole new meaning. From the everyday chaos to the little
				wins, I naturally started creating content that reflects what family life
				actually looks like. That's what led me to <span
					class="text-tertiary font-bold">UGC</span
				>-sharing honest, relatable moments that other parents can see
				themselves in.
			</p>

			<p class="my-6 text-lg">
				My background of 3+ years in <span class="text-tertiary font-bold"
					>video creation</span
				> helps me think beyond trends and focus on what actually <span
					class="text-tertiary font-bold">connects</span
				> with a viewer online. Now, I blend my passion for <span
					class="text-tertiary font-bold">creativity</span
				> with <span class="text-tertiary font-bold">conversion</span>, making
				content that's fun, relatable, and designed to move real families <span
					class="text-tertiary font-bold">toward action</span
				>.
			</p>

			<article class="flex justify-evenly items-center">
				{
					AboutMeData.map((item) => {
						const IconSvg = icons[item.icon];

						return (
							<div
								class={`flex flex-col justify-center items-center text-center
          ${item.id === "family" ? "border-x-2 border-neutral px-6" : ""}`}
							>
								<div class="flex items-center justify-center bg-white w-14 h-14 rounded-full mb-3">
									<IconSvg class="stroke-alert-neutral w-7 h-7" />
								</div>
								<h3 class="text-tertiary font-black uppercase text-sm">
									{item.title}
								</h3>
								<p class="text-sm w-40">{item.description}</p>
							</div>
						);
					})
				}
			</article>

			<!-- Footer -->
			<div class="w-full flex justify-center mt-6">
				<div class="flex justify-between bg-tertiary p-4 rounded-2xl w-104">
					<div class="flex gap-4">
						<div class="bg-white rounded-full">
							<div class="w-13 h-13 flex justify-center items-center">
								<Heart class="w-8 h-8 stroke-alert-neutral" />
							</div>
						</div>
						<p class="text-white">
							Mom, Creator, Storyteller, Turning everyday moments into content
							that connects
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
