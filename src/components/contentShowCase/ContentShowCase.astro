---
import { videosContent } from "../../data/videos";
import { Leaf } from "@lucide/astro";

const videos = await videosContent;
---

<section class="w-full bg-secondary px-4 py-16 sm:px-6 lg:px-8" id="portfolio">
  <div class="mx-auto flex max-w-6xl flex-col items-center text-center">
    <h2
      class="max-w-4xl text-4xl font-bold uppercase leading-tight tracking-tighter sm:text-5xl lg:text-6xl"
    >
      Family Lifestyle Content
    </h2>

    <div class="mb-4 mt-3 h-0.5 w-24 bg-alert-neutral"></div>

    <p class="max-w-2xl text-base leading-relaxed text-neutral-600 sm:text-lg">
      A collection of authentic, relatable content created for family-focused
      brands. Real moments. Real Families. Real impact.
    </p>

    <div
      class="mt-10 grid w-full grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        videos?.map((video) => (
          <div class="mx-auto w-full max-w-65 rounded-2xl bg-white pb-4 shadow-lg transition hover:-translate-y-1 hover:shadow-xl">
            <video
              class="aspect-9/16 w-full rounded-2xl object-cover"
              src={video.src}
              controls
              preload="metadata"
              playsinline
            />

            <div class="mt-4 flex flex-col items-center justify-center gap-2 px-3 text-center">
              <h3 class="text-lg font-black leading-tight">{video.title}</h3>

              <p class="flex w-fit items-center justify-center gap-1 rounded-md bg-optional px-2 py-1 text-sm font-light text-tertiary">
                <Leaf class="h-4 w-4 shrink-0" />
                {video.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
