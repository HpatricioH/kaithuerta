---
import hero from "../../assets/hero.webp";
import HeroHighlights from "./HeroHighlights.astro";

---

<section
  id="hero"
  class="relative h-screen min-h-[60vh] w-full overflow-hidden"
>
  <!-- Background Image -->
  <img
    src={hero.src}
    alt="Kait influencer"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover object-[center_38%]"
  />

  <!-- Optional readability overlay -->
  <div class="absolute inset-0 z-2 bg-black/0"></div>

  <!-- Content -->
  <div class="absolute inset-0 z-3 grid grid-cols-1 md:grid-cols-2">
    <!-- Empty left side -->
    <div class="hidden md:block"></div>

    <!-- Right content -->
    <div
      class="flex items-center justify-center px-6 text-center md:justify-start md:px-12 md:text-left lg:px-20"
    >
      <div class="max-w-170 animate-[fadeUp_0.8s_ease-out_both]">
        <p
          class="mt-4 text-[1.15rem] font-medium tracking-[0.08em] text-[#494c51]
          md:text-[1.4rem]"
        >
          UGC Creator & Strategist | English and Spanish speaking
        </p>

        <h1
          class="uppercase font-bold leading-[0.85] tracking-[-0.06em]
          text-[clamp(3rem,8vw,5rem)]"
        >
          <span class="block pt-4">Real moments.</span>
          <span class="block pt-4">Real connection.</span>
          <span
            class="block pt-4 font-secondary italic text-alert-neutral tracking-wider normal-case"
            >Real Results.</span
          >
          <svg
            width="400"
            height="20"
            viewBox="0 0 400 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M6 12C70 2 160 0 240 4C300 7 350 10 394 6"
              stroke="#C96F7B"
              stroke-width="3"
              stroke-linecap="round"></path>
            <path
              d="M10 14C80 6 170 5 255 8C310 10 355 12 388 10"
              stroke="#C96F7B"
              stroke-width="1.5"
              stroke-linecap="round"
              opacity="0.65"></path>
          </svg>
        </h1>

        <p
          class="mt-5 text-[1.05rem] leading-[1.6] text-primary md:text-[1.3rem] w-120"
        >
          I create authentic, relatable UGC content that helps mama and
          family-focused brands connect with real parents and turn everyday
          moments into impact
        </p>

        <HeroHighlights />
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
