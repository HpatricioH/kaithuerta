---
import { videosContent } from '../../data/videos';
import { Leaf } from "@lucide/astro";

const videos = await videosContent;
---

<section
  class="w-full flex flex-col justify-center items-center py-16 px-4 bg-secondary"
>
  <h2 class="uppercase font-bold text-6xl tracking-tighter">
    Family Lifestyle Content
  </h2>
  <div class=`w-24 h-0.5 bg-alert-neutral mt-2 mb-4`></div>
  <p class="text-lg text-neutral-600 w-148 text-center">
    A collection of authentic, relatable content created for family-focused brands. Real moments. Real Families. Real impact.
  </p>
  <div
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 justify-center max-w-6xl w-full"
  >
    {
      videos?.map((video) => (
        <div class="w-65 mx-auto mt-8 bg-white pb-4 rounded-2xl shadow-lg">
          <video
            class="w-full aspect-9/16 object-cover rounded-2xl"
            src={video.src}
            controls
            preload="metadata"
            playsinline
          />
          <div class="flex flex-col justify-center items-center mt-4 gap-1">
            <h2 class="font-black text-lg">{video.title}</h2>
            <p class="flex justify-center items-center gap-1 font-light text-tertiary bg-optional rounded-md py-1 px-2 w-fit text-sm">
              <Leaf class="w-4 h-4"/>
              {video.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
