---
import {
  MicOff,
  LocateOff,
  CctvOff,
  TimerOff,
  Copy,
  Megaphone,
  Smile,
  SquareDashedText,
  Zap,
  Palette,
  RefreshCcw,
} from "@lucide/astro";

import type { AstroComponentFactory } from "astro/runtime/server/index.js";

type Variant = "positive" | "negative";

type IconName =
  | "Smile"
  | "SquareDashedText"
  | "Zap"
  | "Palette"
  | "RefreshCcw"
  | "MicOff"
  | "LocateOff"
  | "CctvOff"
  | "TimerOff"
  | "Copy"
  | "Megaphone";

interface Item {
  title: string;
  description: string;
  icon: IconName;
}

interface Props {
  items: Item[];
  iconStroke: string;
  title: string;
  Icon: AstroComponentFactory;
  variant: Variant;
}

const { items, iconStroke, title, Icon, variant }: Props = Astro.props;

const styles: Record<Variant, { icon: string; line: string; border: string }> =
  {
    positive: {
      icon: "text-tertiary",
      line: "bg-tertiary",
      border: "border-l-tertiary",
    },
    negative: {
      icon: "text-red-600",
      line: "bg-red-600",
      border: "border-l-red-600",
    },
  };

const icons: Record<IconName, AstroComponentFactory> = {
  Smile,
  SquareDashedText,
  Zap,
  Palette,
  RefreshCcw,
  MicOff,
  LocateOff,
  CctvOff,
  TimerOff,
  Copy,
  Megaphone,
};

const style = styles[variant];
---

<div>
  <!-- Header -->
  <div class="flex items-center gap-2">
    <Icon class=`w-8 h-8 ${style.icon} shrink-0` />
    <h3 class="leading-tight font-black uppercase">{title}</h3>
  </div>

  <div class=`w-full h-0.5 ${style.line} mt-2 mb-4`></div>

  <!-- Card -->
  <ul class="flex flex-col gap-4">
    {
      items.map((item) => {
        const IconSvg = icons[item.icon];

        return (
          <li
            class={`border-l-4 ${style.border} hover:transform hover:-translate-y-1`}
          >
            <article class="flex gap-3 bg-secondary p-4 items-start min-h-28 ">
              <div aria-hidden="true" class="shrink-0">
                <IconSvg stroke={iconStroke} />
              </div>
              <div>
                <h3 class="text-lg font-black">{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          </li>
        );
      })
    }
  </ul>
</div>
