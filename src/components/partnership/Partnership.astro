---
import partnershipPic from "../../assets/partnershipPic.webp";
import { PartnershipData } from "../../data/partnershipData";
import {
  Heart,
  Target,
  MessagesSquare,
  CalendarDays,
  ArrowRight,
  Mail,
} from "@lucide/astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

type IconName = "Heart" | "Target" | "MessagesSquare";

const icons: Record<IconName, AstroComponentFactory> = {
  Heart,
  Target,
  MessagesSquare,
};
---

<section id="contact" class="w-full bg-secondary">
  <div
    class="relative min-h-250 overflow-hidden sm:min-h-205 lg:min-h-225"
  >
    <img
      src={partnershipPic.src}
      alt="Kait and Daughter picture"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover object-top"
    />

    <!-- Readability overlay -->
    <div
      class="absolute inset-0 z-10 bg-white/70 md:bg-white/45 lg:bg-transparent"
    ></div>

    <div class="absolute inset-0 z-20">
      <div class="mx-auto h-full max-w-6xl px-4 sm:px-6 lg:px-8">
        <div
          class="flex h-full w-full max-w-155 flex-col justify-center py-16 text-center lg:w-[48%] lg:text-left"
        >
          <!-- Header -->
          <div class="mb-3 flex items-center justify-center gap-5 md:justify-start">
            <div class="h-0.5 w-24 bg-alert-neutral sm:w-40"></div>

            <Heart
              class="h-6 w-6 shrink-0 fill-alert-neutral stroke-alert-neutral"
            />
          </div>

          <h2
            class="text-4xl font-bold uppercase leading-[0.95] tracking-tight sm:text-5xl md:text-6xl lg:text-7xl"
          >
            Let's kick off a great partnership
          </h2>

          <svg
            class="mx-auto mt-4 h-auto w-full max-w-90 lg:mx-0 lg:max-w-100"
            viewBox="0 0 400 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M6 12C70 2 160 0 240 4C300 7 350 10 394 6"
              stroke="#C96F7B"
              stroke-width="3"
              stroke-linecap="round"></path>
            <path
              d="M10 14C80 6 170 5 255 8C310 10 355 12 388 10"
              stroke="#C96F7B"
              stroke-width="1.5"
              stroke-linecap="round"
              opacity="0.65"></path>
          </svg>

          <!-- Description -->
          <p
            class="mx-auto mt-6 max-w-105 text-lg leading-relaxed sm:text-xl lg:mx-0 lg:text-2xl"
          >
            UGC is not a one-size-fits-all, so let's chat about how to make it
            work for you.
          </p>

          <!-- Partnership Cards -->
          <article
            class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4"
          >
            {
              PartnershipData.map((item) => {
                const IconSvg = icons[item.icon];

                return (
                  <div
                    class={`flex flex-col items-center text-center ${
                      item.id === "strategy"
                        ? "sm:border-x-2 sm:border-neutral/40 sm:px-4"
                        : ""
                    }`}
                  >
                    <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-secondary">
                      <IconSvg class="h-7 w-7 stroke-alert-neutral" />
                    </div>

                    <h3 class="text-sm font-black uppercase">{item.title}</h3>

                    <p class="mt-1 max-w-37.5 text-sm leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                );
              })
            }
          </article>

          <!-- CTA -->
          <div
            class="mt-8 flex w-full flex-col items-stretch justify-center gap-4 sm:flex-row"
          >
            <a
              href="https://calendly.com/your-link"
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-14 items-center justify-center gap-3 rounded-md bg-alert-neutral px-5 py-3 text-white transition hover:opacity-90"
            >
              <CalendarDays class="h-5 w-5 shrink-0" />

              <span class="flex flex-col text-left leading-tight">
                <span>Book a 15 min</span>
                <span>Strategy Call</span>
              </span>

              <ArrowRight class="h-5 w-5 shrink-0" />
            </a>

            <a
              href="mailto:hello@kaithuerta.com"
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-14 items-center justify-center gap-3 rounded-md border-2 border-alert-neutral bg-secondary px-5 py-3 font-semibold text-alert-neutral transition hover:opacity-90"
            >
              <Mail class="h-5 w-5 shrink-0" />
              Email Me
              <ArrowRight class="h-5 w-5 shrink-0" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
